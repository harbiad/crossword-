{
  "name": "crossword-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "bench:crossword": "vitest run --config vitest.benchmark.config.ts",
    "bench:crossword:stress": "CROSSWORD_BENCH_STRESS=1 vitest run --config vitest.benchmark.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "dev": "vite",
    "build": "node ./node_modules/typescript/lib/tsc.js -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:worker": "npm run build && vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "@vercel/node": "^5.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vercel": "^50.17.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
